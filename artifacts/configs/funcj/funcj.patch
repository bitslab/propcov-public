+<?xml version="1.0" encoding="UTF-8"?>
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+    <modelVersion>4.0.0</modelVersion>
+    <parent>
+        <groupId>org.typemeta</groupId>
+        <artifactId>funcj</artifactId>
+        <version>0.6.19-SNAPSHOT</version>
+    </parent>
+    <artifactId>propcovrun</artifactId>
+    <name>${project.groupId}:${project.artifactId}</name>
+    <packaging>pom</packaging>
+    <url>https://github.com/typemeta/funcj</url>
+
+    <properties>
+        <maven.compiler.source>17</maven.compiler.source>
+        <maven.compiler.target>17</maven.compiler.target>
+        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    </properties>
+    <dependencies>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-core</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-json</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-parser</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-codec-core</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-codec-json</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-codec-mpack</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+        <dependency>
+            <groupId>org.typemeta</groupId>
+            <artifactId>funcj-codec-xml</artifactId>
+            <version>0.6.19-SNAPSHOT</version>
+        </dependency>
+    </dependencies>
+
+    <build>
+        <plugins>
+            <plugin>
+                <groupId>org.jacoco</groupId>
+                <artifactId>jacoco-maven-plugin</artifactId>
+                <version>0.8.6</version>
+                <configuration>
+                    <fileSets>
+                        <fileSet implementation="org.apache.maven.shared.model.fileset.FileSet">
+                            <directory>${project.build.directory}</directory>
+                            <includes>
+                                <include>*.exec</include>
+                            </includes>
+                        </fileSet>
+                    </fileSets>
+                </configuration>
+                <executions>
+                    <execution>
+                        <id>merge</id>
+                        <phase>test</phase>
+                        <goals>
+                            <goal>merge</goal>
+                        </goals>
+                    </execution>
+                    <execution>
+                        <id>report</id>
+                        <phase>test</phase>
+                        <goals>
+                            <goal>report</goal>
+                        </goals>
+                    </execution>
+                </executions>
+            </plugin>
